# Warning: `docker compose config` prints these values in cleartext — never run
# that command in a shared or logged terminal session.

# --- Misuratore (generale, valido per ogni vendor futuro) ---
# Gap 9: agent and detector use distinct keys — a compromised container never
# spends or acts on behalf of the other (design doc, "Confine misuratore/misurato").
# Required — the container fails to start without a real key.
AGENT_OPENROUTER_API_KEY=
DETECTOR_OPENROUTER_API_KEY=

# --- Vendor proxy — mappa modelli, contingente a questo vendor (Gap 10) ---
# aidr/serving/model_client.py manda un nome di tier letterale ("sifter"/"inspector"/
# "embed"), non un vero model id OpenRouter — vendor_proxy.py li rimappa. Lasciare vuoto
# per usare il default nel codice (src/detector_adapter/vendor_proxy.py,
# DEFAULT_TIER_TO_MODEL) — non richiesto, a differenza delle chiavi sopra.
SIFTER_MODEL=
INSPECTOR_MODEL=
EMBED_MODEL=

# --- Modello dell'agente giocattolo (lo strumento, non il misurato) ---
# L'agente giocattolo produce i transcript su cui il detector viene giudicato: il suo
# modello e' una condizione sperimentale, e ogni report la dichiara (Gap 20). Lasciare
# vuoto per usare il default nel codice (src/toy_agent/model_client.py, _DEFAULT_MODEL
# = openai/gpt-4o-mini) — non richiesto, come i tre modelli del detector qui sopra.
AGENT_MODEL=

# --- LlamaFirewall (secondo vendor) — file SEPARATO, non qui ---
# Copia questi 2 valori in un file .env.llamafirewall dedicato (mai in
# questo .env — un container non deve mai vedere la chiave di un altro
# vendor, docker-compose.yml legge .env.llamafirewall via env_file: solo
# per il servizio detector-llamafirewall).
#   LLAMAFIREWALL_OPENROUTER_API_KEY=
#   LLAMAFIREWALL_MODEL=
